#include <stdio.h>
#include <ctype.h>

int main()
{
    char cipher[500];
    int key, i;

    printf("Enter ciphertext: ");
    fgets(cipher,sizeof(cipher),stdin);

    printf("\nPossible plaintexts:\n");

    for(key=0; key<26; key++)
    {
        printf("Key %2d : ",key);

        for(i=0; cipher[i]!='\0'; i++)
        {
            if(isalpha(cipher[i]))
            {
                int c = tolower(cipher[i]) - 'a';
                int p = (c-key+26)%26;

                printf("%c",'a'+p);
            }
            else
                printf("%c",cipher[i]);
        }

        printf("\n");
    }

    return 0;
}
