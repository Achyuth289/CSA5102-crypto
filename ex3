#include<stdio.h>
#include<string.h>

char a[5][5]={"MONAR","CHYBD","EFGIK","LPQST","UVWXZ"};

void pos(char c,int *r,int *c1){
    if(c=='J') c='I';
    for(int i=0;i<5;i++)
        for(int j=0;j<5;j++)
            if(a[i][j]==c){*r=i;*c1=j;}
}

int main(){
    char p[20];
    int r1,c1,r2,c2;

    printf("Enter text (2 letters): ");
    scanf("%s",p);

    pos(p[0],&r1,&c1);
    pos(p[1],&r2,&c2);

    if(r1==r2)
        printf("Cipher: %c%c",a[r1][(c1+1)%5],a[r2][(c2+1)%5]);
    else if(c1==c2)
        printf("Cipher: %c%c",a[(r1+1)%5][c1],a[(r2+1)%5][c2]);
    else
        printf("Cipher: %c%c",a[r1][c2],a[r2][c1]);

    return 0;
}
