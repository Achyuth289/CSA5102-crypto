#include <stdio.h>
#include <ctype.h>

int main()
{
    char plaintext[200];
    int key[200];
    int n, i, j = 0;

    printf("Enter plaintext: ");
    fgets(plaintext, sizeof(plaintext), stdin);

    printf("Enter number of key values: ");
    scanf("%d", &n);

    printf("Enter key stream:\n");

    for(i = 0; i < n; i++)
        scanf("%d", &key[i]);

    printf("Ciphertext: ");

    for(i = 0; plaintext[i] != '\0'; i++)
    {
        if(isalpha(plaintext[i]))
        {
            int p = toupper(plaintext[i]) - 'A';
            int c = (p + key[j]) % 26;

            printf("%c", c + 'A');
            j++;
        }
    }

    return 0;
}
