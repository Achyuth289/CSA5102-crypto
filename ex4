#include<stdio.h>
#include<string.h>

int main(){
    char p[100],k[100];
    int i,l;

    printf("Enter Plaintext: ");
    scanf("%s",p);

    printf("Enter Key: ");
    scanf("%s",k);

    l=strlen(k);

    printf("Cipher: ");
    for(i=0;p[i];i++)
        printf("%c",((p[i]-'A')+(k[i%l]-'A'))%26+'A');

    return 0;
}
