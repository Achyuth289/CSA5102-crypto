#include <stdio.h>
#include <ctype.h>

int main()
{
    char keyword[] = "CIPHER";
    char cipher[27];
    int used[26] = {0};
    int i, n = 0;

    for(i = 0; keyword[i] != '\0'; i++)
    {
        int x = keyword[i] - 'A';

        if(!used[x])
        {
            used[x] = 1;
            cipher[n++] = keyword[i];
        }
    }

    for(i = 0; i < 26; i++)
    {
        if(!used[i])
            cipher[n++] = 'A' + i;
    }

    cipher[26] = '\0';

    printf("Cipher alphabet: %s\n", cipher);

    return 0;
}
