#include <stdio.h>
#include <ctype.h>

int inverse(int a)
{
    int i;

    for(i = 0; i < 26; i++)
        if((a * i) % 26 == 1)
            return i;

    return -1;
}

int main()
{
    char cipher[500];
    int a, b, i, inv, y, x;

    printf("Enter ciphertext: ");
    fgets(cipher, sizeof(cipher), stdin);

    printf("\nPossible plaintexts:\n");

    for(a = 0; a < 26; a++)
    {
        inv = inverse(a);

        if(inv == -1)
            continue;

        for(b = 0; b < 26; b++)
        {
            printf("a=%d b=%d : ", a, b);

            for(i = 0; cipher[i] != '\0'; i++)
            {
                if(isalpha(cipher[i]))
                {
                    y = toupper(cipher[i]) - 'A';
                    x = (inv * (y - b + 26)) % 26;

                    printf("%c", x + 'A');
                }
                else
                    printf("%c", cipher[i]);
            }

            printf("\n");
        }
    }

    return 0;
}
