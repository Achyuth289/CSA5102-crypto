#include <stdio.h>

int main()
{
    int K[2][2];
    int P1[2] = {1,0};
    int P2[2] = {0,1};
    int C1[2], C2[2];

    printf("Enter 2x2 Hill cipher key:\n");

    for(int i=0;i<2;i++)
        for(int j=0;j<2;j++)
            scanf("%d",&K[i][j]);

    C1[0] = (K[0][0]*P1[0] +
             K[0][1]*P1[1]) % 26;

    C1[1] = (K[1][0]*P1[0] +
             K[1][1]*P1[1]) % 26;

    C2[0] = (K[0][0]*P2[0] +
             K[0][1]*P2[1]) % 26;

    C2[1] = (K[1][0]*P2[0] +
             K[1][1]*P2[1]) % 26;

    printf("Chosen plaintext P1 = [1 0]\n");
    printf("Ciphertext C1 = [%d %d]\n",C1[0],C1[1]);

    printf("Chosen plaintext P2 = [0 1]\n");
    printf("Ciphertext C2 = [%d %d]\n",C2[0],C2[1]);

    printf("\nThe ciphertext vectors reveal the key matrix columns.\n");

    return 0;
}
