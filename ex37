#include <stdio.h>
#include <ctype.h>

int main()
{
    char cipher[2000];
    int frequency[26] = {0};
    int i;

    printf("Enter ciphertext:\n");
    fgets(cipher, sizeof(cipher), stdin);

    for(i = 0; cipher[i] != '\0'; i++)
    {
        if(isalpha(cipher[i]))
            frequency[tolower(cipher[i]) - 'a']++;
    }

    printf("\nFrequency of letters:\n");

    for(i = 0; i < 26; i++)
    {
        printf("%c = %d\n",
               'A' + i,
               frequency[i]);
    }

    printf("\nEnglish frequency order:\n");
    printf("E T A O I N S H R D L C U M W F G Y P B V K J X Q Z\n");

    printf("\nUse frequency and word-pattern scoring to generate top candidates.\n");

    return 0;
}
