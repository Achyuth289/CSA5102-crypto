#include <stdio.h>

int inverse(int a)
{
    int i;

    for(i = 0; i < 26; i++)
        if((a*i)%26 == 1)
            return i;

    return -1;
}

int main()
{
    int P[2][2], C[2][2], PI[2][2], K[2][2];
    int det, inv, i, j;

    printf("Enter plaintext matrix P:\n");

    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
            scanf("%d",&P[i][j]);

    printf("Enter ciphertext matrix C:\n");

    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
            scanf("%d",&C[i][j]);

    det = (P[0][0]*P[1][1] -
           P[0][1]*P[1][0]) % 26;

    if(det < 0)
        det += 26;

    inv = inverse(det);

    if(inv == -1)
    {
        printf("Matrix P is not invertible.\n");
        return 0;
    }

    PI[0][0] = P[1][1];
    PI[0][1] = -P[0][1];
    PI[1][0] = -P[1][0];
    PI[1][1] = P[0][0];

    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
        {
            PI[i][j] =
                (PI[i][j] * inv) % 26;

            if(PI[i][j] < 0)
                PI[i][j] += 26;
        }

    for(i=0;i<2;i++)
        for(j=0;j<2;j++)
        {
            K[i][j] = 0;

            for(int k=0;k<2;k++)
                K[i][j] =
                    (K[i][j] +
                     C[i][k]*PI[k][j]) % 26;
        }

    printf("Recovered key matrix:\n");

    for(i=0;i<2;i++)
    {
        for(j=0;j<2;j++)
            printf("%d ",K[i][j]);

        printf("\n");
    }

    return 0;
}
