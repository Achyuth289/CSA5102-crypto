#include <stdio.h>
#include <string.h>

int main()
{
    char text[100];
    int len, pad, i;

    printf("Enter plaintext: ");
    fgets(text,sizeof(text),stdin);

    len = strlen(text);

    if(text[len-1] == '\n')
        len--;

    pad = 8 - (len % 8);

    printf("Padding bits/bytes required = %d\n",pad);

    printf("Reason: padding makes the end of plaintext\n");
    printf("unambiguous during decryption.\n");

    return 0;
}
